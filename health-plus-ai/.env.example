# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — secrets never reach the repository.

# --- LLM ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
# OpenRouter: one key for many models (default model is free)
OPENROUTER_API_KEY=your-openrouter-api-key-here
HEALTHPLUS_OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
# Privacy: only use providers that never store/train on prompts.
# Excludes most FREE models, so enable it with paid models.
HEALTHPLUS_OPENROUTER_DENY_DATA_COLLECTION=false

# --- Application (all optional, sensible defaults exist) ---
HEALTHPLUS_ENVIRONMENT=development
HEALTHPLUS_DEBUG=false
HEALTHPLUS_LOG_LEVEL=INFO
HEALTHPLUS_CLAUDE_MODEL=claude-sonnet-5
HEALTHPLUS_CLAUDE_MAX_TOKENS=1024
HEALTHPLUS_RETRIEVAL_TOP_K=5
HEALTHPLUS_RETRIEVAL_MIN_SCORE=0.30
HEALTHPLUS_CONTEXT_MAX_CHARS=8000
HEALTHPLUS_MEMORY_MAX_TURNS=10
HEALTHPLUS_DATA_DIR=data
HEALTHPLUS_LOG_DIR=logs
