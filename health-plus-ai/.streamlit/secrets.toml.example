# Template for Streamlit secrets. Copy to .streamlit/secrets.toml (git-ignored)
# for local runs, or paste into Settings -> Secrets on Streamlit Cloud.

# LLM key (OpenRouter is the default provider)
OPENROUTER_API_KEY = "sk-or-v1-your-key-here"

# Login accounts. Create each block with:  python scripts/hash_password.py
# role = "admin" -> chat + admin panel;  role = "user" -> chat only.
# The app stays locked until at least one account is configured.

[accounts.admin]
name = "Hospital Admin"
role = "admin"
password_hash = "pbkdf2_sha256$600000$REPLACE$WITH-OUTPUT-OF-hash_password.py"

[accounts.reception]
name = "Front Desk"
role = "user"
password_hash = "pbkdf2_sha256$600000$REPLACE$WITH-OUTPUT-OF-hash_password.py"
